# Neon PostgreSQL — get from Neon dashboard → Connection string
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.neon.tech/neondb?sslmode=require"

# ── Live data integrations (optional — falls back to simulation if unset) ──

# Kalshi prediction market API key
# Get from: https://kalshi.com/account/developer → API Keys
# Enables real Kalshi contract prices for match outcome markets
KALSHI_API_KEY=""

# api-football.com API key
# Get from: https://dashboard.api-football.com → My Account → API Key
# Free tier: 100 req/day. Enables live scores, lineups, squads, events for WC 2026.
API_FOOTBALL_KEY=""

# Admin seed secret (optional override — defaults to "wc2026studio0x")
SEED_SECRET=""

# ── Deployment selector ────────────────────────────────────────────────────
# Which tournament this instance serves: worldcup | leaguescup | f1-2026.
# Unset = worldcup (WC26 reference deployment).
TOURNAMENT=""
# REQUIRED for any non-default deployment. TOURNAMENT is server-only — Next.js
# inlines only NEXT_PUBLIC_* into the client bundle — so without this the browser
# falls back to World Cup config while the server serves the real one (LC26
# symptom: August fixtures classified against WC26's June knockout dates).
# next.config.ts derives it from TOURNAMENT at build time, so setting TOURNAMENT
# alone works; set this too when you want it explicit.
NEXT_PUBLIC_TOURNAMENT=""

# api-football league/season overrides for the Leagues Cup deployment.
# Defaults: 772 / 2026 (v3 league id — 8157 is the legacy V2 per-season id).
LEAGUES_CUP_LEAGUE_ID=""
LEAGUES_CUP_SEASON=""

# ── Google Drive (anthem folder discovery) ─────────────────────────────────
# REQUIRED on club deployments (LC26). WC26's 54 anthems are enumerated by file
# id in src/lib/anthemManifest.ts and need no key — downloading a public Drive
# file is unauthenticated. LISTING a folder is not: club anthems live in a folder
# tree the importer has to walk, which uses Drive API v3 files.list.
#
# Google Cloud Console → APIs & Services → enable "Google Drive API" →
# Credentials → Create API key → restrict it to the Drive API.
# The anthem folders must also be shared "Anyone with the link".
# Without this the anthem import fails CLOSED: it imports nothing and, crucially,
# prunes nothing.
GOOGLE_DRIVE_API_KEY=""

# Root of the LC26 anthem tree (Anthems_LeaguesCup_2026). Defaults to the known
# folder id; override only if the folder moves.
LC26_ANTHEM_FOLDER_ID=""
