generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  WHITE_LABEL  // Paid partner — gets branded embed + API access
  USER
}

enum SponsorTier {
  TITLE        // "Presented by X" — top placement everywhere
  MATCH        // Sponsors individual match pages
  GROUP        // Sponsors a group stage
  ANTHEM       // Sponsors the anthems page / specific team anthem
  BANNER       // Standard banner slot
}

enum AdSlotPlacement {
  HOME_HERO    // Top of dashboard
  SCHEDULE_TOP // Above schedule list
  MATCH_DETAIL // Match detail page header
  STANDINGS    // Below standings table
  ANTHEMS      // Anthems page
  SIDEBAR      // Right sidebar (desktop)
}

model User {
  id               String              @id @default(cuid())
  name             String?
  email            String              @unique
  emailVerified    DateTime?
  image            String?
  role             Role                @default(USER)
  accounts         Account[]
  sessions         Session[]
  predictions      Prediction[]
  whiteLabelConfig WhiteLabelPartner?
  createdAt        DateTime            @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fixtureId Int
  home      Int
  away      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fixtureId])
}

model Team {
  id          String        @id @default(cuid())
  name        String        @unique
  code        String        @unique
  flagEmoji   String
  groupStage  String
  // Country as api-football spells it. Added 8/4 for club deployments: a club's
  // badge comes from the country it plays in, NOT from its 3-letter code (which
  // collides with nation TLAs — Columbus Crew emits "COL" and was rendering
  // Colombia's flag). Empty for nation deployments, which key off the code.
  country     String        @default("")
  // api-football team id — the ONLY identifier the feed always supplies. Club
  // feeds omit `team.code` for 14 of 36 Leagues Cup clubs, so code-keyed
  // ingestion silently dropped their fixtures. Nullable for rows seeded before
  // this field existed.
  //
  // Indexed, NOT @unique, on purpose: Vercel's build runs `prisma db push`
  // without --accept-data-loss, and adding a unique constraint to a populated
  // table makes push refuse and the deploy fail. Uniqueness is maintained by
  // the sync (one row per feed team) and by Team.name being unique.
  afTeamId    Int?
  // Club crest URL from the api-football /teams feed. Added 8/4: a club has no
  // national flag, so the crest IS its badge. Empty for nation deployments,
  // which render a flag from the FIFA TLA.
  logoUrl     String        @default("")
  anthem      AudioStream?
  homePlayers Player[]
  homeMatches Match[]       @relation("HomeTeam")
  awayMatches Match[]       @relation("AwayTeam")
  createdAt   DateTime      @default(now())

  @@index([afTeamId])
}

model Player {
  id             String                @id @default(cuid())
  name           String
  number         Int
  position       String
  teamId         String
  team           Team                  @relation(fields: [teamId], references: [id])
  club           String                @default("")
  league         String                @default("")
  caps           Int                   @default(0)
  goals          Int                   @default(0)
  dateOfBirth    String                @default("")
  photoUrl       String?
  tournamentStat PlayerTournamentStat?
  matchStats     PlayerMatchStat[]
}

model PlayerTournamentStat {
  id               String   @id @default(cuid())
  playerId         String   @unique
  player           Player   @relation(fields: [playerId], references: [id])
  // Totals (accumulated across all matches)
  goals            Int      @default(0)
  assists          Int      @default(0)
  matches          Int      @default(0)
  minutesPlayed    Int      @default(0)
  yellowCards      Int      @default(0)
  redCards         Int      @default(0)
  rating           Float    @default(0)   // average across matches
  // Shooting
  shotsTotal       Int      @default(0)
  shotsOnTarget    Int      @default(0)
  // Passing
  passesTotal      Int      @default(0)
  passesKey        Int      @default(0)
  // Defensive
  tacklesTotal     Int      @default(0)
  tackleBlocks     Int      @default(0)
  interceptions    Int      @default(0)
  // Duels
  duelsTotal       Int      @default(0)
  duelsWon         Int      @default(0)
  // Dribbles
  dribblesAttempts Int      @default(0)
  dribblesSuccess  Int      @default(0)
  // Discipline
  foulsDrawn       Int      @default(0)
  foulsCommitted   Int      @default(0)
  // Penalties
  penaltiesScored  Int      @default(0)
  penaltiesMissed  Int      @default(0)
  updatedAt        DateTime @updatedAt
}

model PlayerMatchStat {
  id               String   @id @default(cuid())
  playerId         String
  player           Player   @relation(fields: [playerId], references: [id])
  matchId          String
  match            Match    @relation(fields: [matchId], references: [id])
  minutesPlayed    Int      @default(0)
  rating           Float    @default(0)
  goals            Int      @default(0)
  assists          Int      @default(0)
  captain          Boolean  @default(false)
  substitute       Boolean  @default(false)
  shotsTotal       Int      @default(0)
  shotsOnTarget    Int      @default(0)
  passesTotal      Int      @default(0)
  passesKey        Int      @default(0)
  passAccuracy     Int      @default(0)
  tacklesTotal     Int      @default(0)
  tackleBlocks     Int      @default(0)
  interceptions    Int      @default(0)
  duelsTotal       Int      @default(0)
  duelsWon         Int      @default(0)
  dribblesAttempts Int      @default(0)
  dribblesSuccess  Int      @default(0)
  foulsDrawn       Int      @default(0)
  foulsCommitted   Int      @default(0)
  yellowCards      Int      @default(0)
  redCards         Int      @default(0)
  penaltiesScored  Int      @default(0)
  penaltiesMissed  Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([playerId, matchId])
}

model Match {
  id           String            @id @default(cuid())
  fixture      Int               @unique
  // api-football league id this fixture belongs to. Added 8/4: the DB had no way
  // to tell one tournament's rows from another's, so "clear the other
  // tournament's data" was not expressible. 0 = seeded before this field
  // existed (treated as unknown, never as "belongs to us").
  leagueId     Int               @default(0)
  homeTeamId   String
  awayTeamId   String
  homeTeam     Team              @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team              @relation("AwayTeam", fields: [awayTeamId], references: [id])
  venue        String
  city         String
  // api-football venue id. Added 8/5: the fixture feed omits `venue.city` for
  // most Leagues Cup fixtures (40 of 54 had an empty city), and weather ingest
  // needs COORDINATES, which the feed never supplies. The id lets us resolve the
  // venue once via /venues and cache its city + geocoded lat/lng (see Venue).
  venueId      Int?
  date         DateTime
  status       String            @default("NS")
  homeScore    Int               @default(0)
  awayScore    Int               @default(0)
  // Shootout scores — null unless decided on penalties. Added 7/20 (audit H-6):
  // the DB previously could not represent a shootout at all, so the degraded
  // DB-only schedule path (synthesizeFromDb) could not name a champion after a
  // drawn-then-pens final. Fixture sync now persists these from the feed.
  penHome      Int?
  penAway      Int?
  elapsed      Int               @default(0)
  round        String            @default("Group Stage")
  referee      String?           // match official (from api-football) — powers Officials profiles
  goalEvents   Json?             // admin override: [{minute,team,scorer,assist,isOwnGoal,isPenalty}]
  metrics      LiveMetric[]
  markets      KalshiMarket[]
  playerStats  PlayerMatchStat[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model NewsStory {
  id            String   @id @default(cuid())
  date          DateTime           // the day the story pertains to (UTC)
  matchday      Int?               // optional matchday number
  fixture       Int?               // api-football fixture id (set for GAME RECAP, for dedup)
  category      String             // GAME RECAP | DAILY RECAP | MATCH REPORT | ANALYSIS | STANDINGS | METRIC SPOTLIGHT
  headline      String
  body          String
  teamsInvolved String[]           // team codes (TLAs) for flag display
  audioUrl      String?
  generatedAt   DateTime @default(now())
  // Deployment id (worldcup | leaguescup | f1-2026) this story was written for.
  // Added 8/4: LC26 shipped with World Cup copy because prompts hardcoded the
  // tournament AND stories carried no provenance, so bad copy couldn't be
  // identified or purged selectively. "" = written before this field existed.
  tournamentId  String   @default("")

  @@index([date])
  @@index([fixture])
  @@index([tournamentId])
}

// One canonical Roundtable episode per fixture (owner 7/18): persisting the
// script means every serverless instance serves the SAME episode (so the
// global TTS audio cache works for all users) and episodes survive redeploys
// as part of the tournament archive.
model RoundtableEpisode {
  id          String   @id @default(cuid())
  fixture     Int      @unique // api-football fixture id
  title       String
  matchup     String
  lines       Json               // [{ speaker, text }]
  itFactor    Json?              // panel gut-read intangibles per team (opinion, matchday special 7/18)
  promptRev   String   @default("v1") // pre-kickoff episodes regenerate when the script brief changes
  generatedAt DateTime @default(now())
}

// ── AI Live 360 Roundtable — the multi-match audio show ──────────────────────
// RoundtableEpisode above is PER-FIXTURE (`fixture @unique`): one frozen pregame
// episode per match. The 360 show is the opposite shape — a rolling broadcast
// covering EVERY live fixture at once, regenerated every ~30-90s for as long as
// anything is in play. So it gets its own table rather than a synthetic fixture
// id squatting on the pregame archive's unique key.
//
// Rows are a broadcast LOG, not a cache: each is the script that actually aired
// at that moment, which is what makes "what did the booth say when X happened?"
// answerable after the fact. Additive-only — `prisma db push` in the Vercel build
// creates it without touching any existing table.
model Live360Episode {
  id           String   @id @default(cuid())
  tournamentId String // DeploymentConfig.id — scopes rows per deployment
  fixtures     Int[] // every fixture this episode covered
  lines        Json // [{ speaker, text }] — speaker is a persona key
  matchContext Json // grounded snapshot fed to the model (scores, minutes, moments)
  // Highest-significance moment this episode leads with, as `${fixture}|${momentKey}`.
  // Drives the stinger cue AND stops the next episode re-leading with the same goal.
  leadMomentKey String?
  // Moment type behind leadMomentKey (GOAL / RED_CARD / …) — the stinger to fire.
  leadMomentType String?
  promptRev    String   @default("v1")
  generatedAt  DateTime @default(now())

  @@index([tournamentId, generatedAt])
}

model LiveMetric {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id])
  teamCode   String
  metricType String
  value      Float
  recordedAt DateTime @default(now())
}

model KalshiMarket {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id])
  contractSlug String
  outcome      String
  price        Float
  volume       Int      @default(0)
  lastTick     DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([matchId, outcome])
}

model AudioStream {
  id             String   @id @default(cuid())
  teamId         String?  @unique
  team           Team?    @relation(fields: [teamId], references: [id])
  title          String
  artistCredit   String   @default("Suno AI × Studio0x")
  audioUrl       String
  coverArt       String?
  durationSecs   Int      @default(180)
  playCount      Int      @default(0)
  listenSeconds  Int      @default(0)
  shareClicks    Int      @default(0)
  tiktokDeepLink String?
  createdAt      DateTime @default(now())
}

// ── Sponsors & Advertising ─────────────────────────────────────────────────

model Sponsor {
  id          String      @id @default(cuid())
  name        String      @unique
  logoUrl     String?
  websiteUrl  String?
  tier        SponsorTier
  active      Boolean     @default(true)
  startDate   DateTime?
  endDate     DateTime?
  adSlots     AdSlot[]
  createdAt   DateTime    @default(now())
}

model AdSlot {
  id          String          @id @default(cuid())
  sponsorId   String
  sponsor     Sponsor         @relation(fields: [sponsorId], references: [id])
  placement   AdSlotPlacement
  imageUrl    String?         // banner creative
  linkUrl     String?
  ctaText     String?         // "Visit →"
  active      Boolean         @default(true)
  impressions Int             @default(0)
  clicks      Int             @default(0)
  // Optional targeting
  matchId     String?         // null = all matches
  groupCode   String?         // null = all groups
  createdAt   DateTime        @default(now())
}

// ── White Label Partners ───────────────────────────────────────────────────

model WhiteLabelPartner {
  id           String   @id @default(cuid())
  userId       String   @unique  // must have role = WHITE_LABEL
  user         User     @relation(fields: [userId], references: [id])
  orgName      String
  logoUrl      String?
  primaryColor String   @default("#F5B800")  // defaults to brand-gold
  domain       String?  // custom domain if they have one
  embedKey     String   @unique @default(cuid())  // API key for embed widget
  active       Boolean  @default(true)
  planName     String   @default("starter")  // starter, pro, enterprise
  createdAt    DateTime @default(now())
}

// ── Live event capture (VAR Freeze™ §15) ─────────────────────────────────────
// The api-football feed carries only MATCH MINUTES for events. To measure real
// wall-clock gaps (e.g. whistle→penalty after a long VAR review — owner heard
// 3m11s on the FRA-MAR broadcast), we record when each event FIRST APPEARS in
// our live polling. firstSeenAt deltas ≈ real elapsed time ± feed latency —
// always disclosed as a Studio0x live-capture measurement. Rows are only ever
// written while a match is LIVE/HT (writing after FT would fabricate timing).
model MatchEventLog {
  id          String   @id @default(cuid())
  fixture     Int
  eventKey    String   // `${type}|${detail}|${minute}|${player}` — stable dedup key
  minute      Int
  type        String
  detail      String
  team        String
  player      String?
  // Assisting player on a goal (null for cards, subs, and unassisted goals).
  assist      String?
  firstSeenAt DateTime @default(now())

  @@unique([fixture, eventKey])
  @@index([fixture])
}

// The event bus's durable moment stream — the sport-agnostic generalization of
// MatchEventLog (the GoalEvent→MomentEvent migration flagged as highest-value).
// EVERY live event (any sport) publishes a scored MatchMoment here; every
// consumer (a match view, the Roundtable, the future 0x360 multiview) is a query
// over this one table. `type` is a String on purpose: football moments publish
// now, and F1 moment types (OVERTAKE/PIT_STOP/FASTEST_LAP) are a config swap with
// NO schema change. `momentKey` keeps MatchEventLog's stable-dedup contract so
// polling re-observation upserts instead of duplicating. tournamentId scopes rows
// per deployment (worldcup/leaguescup/f1-2026).
model MatchMoment {
  id                 String    @id @default(cuid())
  tournamentId       String
  fixture            Int
  matchId            String? // internal Match.id once resolved (optional)
  momentKey          String // stable dedup: `${type}|${period}|${minute}|${detail}`
  type               String // MomentType (union stored as string — F1-ready)
  period             String?
  minute             Int
  clockLabel         String?
  team               String?
  entity             String? // player / driver
  payload            Json? // type-specific, grounded-only detail
  significance       Int       @default(0)
  significanceReason String?
  source             String    @default("real") // real | reconstructed
  occurredAt         DateTime?
  firstSeenAt        DateTime  @default(now())
  publishedAt        DateTime  @default(now())

  @@unique([tournamentId, fixture, momentKey])
  @@index([tournamentId, fixture])
  @@index([tournamentId, publishedAt])
  @@index([tournamentId, significance])
}

// Heat vs. Outcomes (Cramp Watch™ aggregate, backlog §16): one row per fixture
// with the REAL kickoff-hour weather (Open-Meteo hourly archive — retrieval of
// archived fact, honest to backfill) plus outcome facts computed from the
// api-football events feed once the match is FT. climateControlled venues are
// excluded from heat buckets — their outdoor reading isn't match conditions.
model MatchWeather {
  id                String   @id @default(cuid())
  fixture           Int      @unique
  kickoff           DateTime
  tempC             Float
  feelsC            Float
  humidity          Float
  band              String   // Low | Moderate | High | Extreme (lib/heat.ts)
  source            String   // "archive" (past day) | "recent" (same-day hourly)
  climateControlled Boolean  @default(false)
  // Air quality at kickoff (Open-Meteo Air Quality/CAMS): US AQI + PM2.5 µg/m³.
  // Catches wildfire smoke. null = service had no data — never fabricated.
  aqi               Float?
  pm25              Float?
  // Kickoff-hour UV index (Open-Meteo air-quality service). Null = the service
  // had no reading for that hour — never fabricated, same contract as aqi/pm25.
  uvIndex           Float?
  // Outcome facts — null until the match is FT and events were ingested
  totalGoals        Int?
  lateGoals         Int?     // goals scored 75'+ (excl. missed pens)
  cards             Int?
  subsAfter75       Int?     // labeled PROXY for fatigue — no cramp event exists
  capturedAt        DateTime @default(now())

  @@index([band])
}

// ── Team match statistics (api-football /fixtures/statistics) ────────────────
// One row per fixture holding BOTH sides' team-level stats. Written by the
// live-sync cron while a match is in play and rewritten from the post-match
// pull, which is more complete (the provider fills blanks after FT).
//
// Every field is nullable on purpose: the provider omits stats it doesn't have
// for a given fixture, and a missing stat must stay missing rather than being
// coerced to 0 — "0 shots on target" and "the feed didn't report shots" are
// different claims (CLAUDE.md CONTENT TRUTH). The UI must render null as "—".
model MatchStats {
  id                String   @id @default(cuid())
  fixture           Int      @unique
  matchId           String?  // internal Match.id once resolved

  possessionHome    Int?     // percent
  possessionAway    Int?

  shotsTotalHome    Int?
  shotsTotalAway    Int?
  shotsOnHome       Int?
  shotsOnAway       Int?
  shotsOffHome      Int?
  shotsOffAway      Int?
  shotsBlockedHome  Int?
  shotsBlockedAway  Int?

  foulsHome         Int?
  foulsAway         Int?
  cornersHome       Int?
  cornersAway       Int?
  offsidesHome      Int?
  offsidesAway      Int?

  yellowHome        Int?
  yellowAway        Int?
  redHome           Int?
  redAway           Int?

  savesHome         Int?
  savesAway         Int?

  passAccuracyHome  Int?     // percent
  passAccuracyAway  Int?

  /// "live" while the match is in play, "final" once ingested after FT.
  phase             String   @default("live")
  capturedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([matchId])
}

// ── Venue metadata + coordinates ────────────────────────────────────────────
// api-football gives a venue NAME on every fixture, a city on only some, and
// coordinates on none. lib/venues.ts has exact coordinates, but only for the 16
// World Cup stadiums — so on any other competition the weather ingest resolved
// no venue and skipped every match (`skippedNoVenue`).
//
// This caches, per venue: the city/country from /venues, and lat/lng from
// Open-Meteo's geocoding service. `source` records where the coordinates came
// from so a city-level reading is never presented as stadium-exact.
model Venue {
  id          String   @id @default(cuid())
  /// api-football venue id when known; name is the stable fallback key.
  afVenueId   Int?     @unique
  name        String   @unique
  city        String   @default("")
  country     String   @default("")
  capacity    Int?
  lat         Float?
  lng         Float?
  /// "venue-table" = exact stadium coords from lib/venues.ts.
  /// "geocoded-city" = city centroid from Open-Meteo geocoding (approximate).
  /// "unresolved" = looked up and found nothing; retried on a later run.
  source      String   @default("unresolved")
  resolvedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
}
